# ── Mode data ──────────────────────────────────────────────
# Kosongkan NEXT_PUBLIC_SUPABASE_URL untuk mode LOKAL (data disimpan di .data/db.json).
# Isi ketiganya untuk mode SUPABASE.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hanya untuk mode LOKAL: secret penanda tangan cookie sesi. Abaikan jika pakai Supabase.
LOCAL_SESSION_SECRET=ganti-dengan-string-acak-panjang

# URL publik dashboard (dipakai untuk link di payload n8n).
APP_URL=http://localhost:3000

# ── n8n ────────────────────────────────────────────────────
# Base URL webhook n8n, contoh: https://n8n.withdomma.com
# Dashboard POST ke {N8N_WEBHOOK_BASE_URL}/webhook/invoice/{submitted|approved|revision|rejected|cancelled|paid}
# Payload berisi notify_emails = daftar penerima email notifikasi.
N8N_WEBHOOK_BASE_URL=
# Dikirim sebagai header "x-domma-secret" ke n8n.
N8N_WEBHOOK_SECRET=
# n8n memanggil /api/n8n/* dengan header "x-domma-secret" berisi nilai ini.
# Juga dipakai menandatangani token sementara (15 menit) untuk halaman cetak yang dirender n8n jadi PDF.
N8N_CALLBACK_SECRET=
